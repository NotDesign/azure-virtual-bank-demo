# Keep real values outside dist/Git/public folders. Values below do NOT send.
NOTIFY_BINDINGS_FILE=/ABSOLUTE/PRIVATE/PATH/bindings.private.json
NOTIFY_STATE_DIR=/ABSOLUTE/PRIVATE/PATH/delivery-state
NOTIFY_TIMEOUT_MS=8000
NOTIFY_RETRIES=1
TELEGRAM_BOT_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Copy the supported version shown by Meta's own API setup; no guessed default.
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_TEMPLATE_BODY_PARAMS=3
